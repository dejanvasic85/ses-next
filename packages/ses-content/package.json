{
  "name": "ses-content",
  "private": true,
  "version": "1.0.0",
  "main": "package.json",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "sanity dev",
    "start": "sanity start",
    "build": "sanity build",
    "deploy": "sanity deploy",
    "deploy-graphql": "sanity graphql deploy",
    "deploy:schema": "sanity schema deploy",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type:check": "tsc --noEmit",
    "typegen": "sanity schema extract --path ../../packages/ses-next/src/sanity/schema.json && sanity typegen generate"
  },
  "keywords": [
    "sanity"
  ],
  "dependencies": {
    "@sanity/client": "7.26.0",
    "@sanity/import": "6.0.3",
    "@sanity/vision": "6.8.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-is": "19.2.8",
    "sanity": "6.8.0",
    "styled-components": "6.4.4"
  },
  "devDependencies": {
    "@sanity/eslint-config-studio": "6.0.0",
    "eslint": "9.39.5",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0"
  },
  "prettier": {
    "semi": false,
    "printWidth": 100,
    "bracketSpacing": false,
    "singleQuote": true
  }
}
