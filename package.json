{
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "turbo dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type:check": "turbo type:check",
    "test:e2e": "turbo test:e2e",
    "build": "turbo build",
    "lint": "turbo lint",
    "lint:fix": "turbo lint:fix",
    "lint-staged": "lint-staged",
    "ci": "turbo ci",
    "deploy:content": "pnpm --filter ses-content build && pnpm --filter ses-content run deploy",
    "update:rating": "pnpm --filter ses-reviews update:reviews",
    "update:reviews": "pnpm --filter ses-reviews update:reviews",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "9.1.7",
    "lint-staged": "17.5.1",
    "next": "16.3.5",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "turbo": "2.10.13"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json}": [
      "prettier . --write",
      "pnpm --filter ses-next lint"
    ]
  },
  "packageManager": "pnpm@12.4.1+sha512.2e81e399d73fe8390dab25e06aa788ab7a5908248d2f5a370f82b481147a6a7a367bf8048f9a6fdb6460f21a66f0542dedb8b94ca2c8723596741920b1656d4c"
}
